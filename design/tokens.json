{
  "$description": "Tokens de Bouture, exportés des variables de la maquette Figma (format Design Tokens du W3C). Repris à la main dans apps/web/src/index.css.",
  "color": {
    "$type": "color",
    "leaf": {
      "50": { "$value": "#eef5ec" },
      "100": { "$value": "#d8e8d3" },
      "600": { "$value": "#3d7f47" },
      "700": { "$value": "#2f6b3a" },
      "900": { "$value": "#1c3f23" }
    },
    "terracotta": {
      "100": { "$value": "#f6e3da" },
      "600": { "$value": "#b4532a" }
    },
    "sand": {
      "50": { "$value": "#fbfaf6" },
      "100": { "$value": "#f3f1ea" },
      "300": { "$value": "#dcd8cc" }
    },
    "ink": {
      "500": { "$value": "#5c665a" },
      "900": { "$value": "#1f2a1f" }
    },
    "danger": { "600": { "$value": "#b42318" } }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.5rem" }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Geist Variable", "sans-serif"] }
  }
}
