{
  // Réglages communs à tous les paquets du dépôt : chaque paquet l'étend avec "extends"
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
