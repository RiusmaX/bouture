{
  "name": "bouture",
  "version": "1.0.0",
  "description": "Gestion de pépinière, fil rouge de la formation TypeScript full-stack",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:migrate": "npm run db:migrate -w @bouture/api",
    "db:seed": "npm run db:seed -w @bouture/api",
    "dev:api": "npm run dev -w @bouture/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
