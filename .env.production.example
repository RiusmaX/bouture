# Copier en .env sur le serveur, puis remplir. Ne jamais commiter le vrai fichier.
POSTGRES_PASSWORD=
# Générer avec : openssl rand -hex 32
JWT_SECRET=
# Le nom de domaine qui pointe vers le serveur (HTTPS automatique). « :80 » pour un test sans domaine.
SITE_ADDRESS=bouture.example.com
COOKIE_SECURE=true
